# 复制成 mir2.env 后按需修改（`docker compose --env-file mir2.env up -d`）。
# 这个文件只给 compose 用；`.env` 是本地开发用的，两者不要混。

# 对外暴露的游戏端口（Crystal 客户端默认连 7000）。
MIR2_PORT=7000

# PostgreSQL 口令（compose 里的 postgres 与 server 共用）。
POSTGRES_PASSWORD=mir2

# Crystal 的 Server.MirDB 容器里看不见也没关系：留空就用「只刷演示怪」的兜底世界。
# 想在容器里用真实数据，把文件挂进容器后再填容器内路径，例如 /app/resource/data/Server.MirDB。
MIR2_DB_PATH=

# 1 = 尝试加载 MirDB（找不到会自动降级），0 = 强制只用演示怪。
MIR2_LOAD_GAME_DATA=1

# info / debug / trace
RUST_LOG=info
